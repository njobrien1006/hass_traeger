{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Run Home Assistant on port 8123",
            "type": "shell",
            "command": "scripts/develop",
            "problemMatcher": []
        },
        {
            "label": "Pytest + Logging + Failon_1st + Test Matching + Snapshot Update",
            "type": "shell",
            "command": "pytest --log-cli-level=INFO -x -k 'test_climate_platform' --snapshot-update",
            "problemMatcher": []
        },
        {
            "label": "Pytest & Coverage Badge & Coverage Report",
            "type": "shell",
            "command": "pytest --cov=custom_components/traeger && coverage-badge -o images/coverage.svg -f && coverage html -d tests/coverage",
            "problemMatcher": []
        },
        {
            "label": "Pylint Component",
            "type": "shell",
            "command": "pylint custom_components/traeger/ --disable=duplicate-code,abstract-method,overridden-final-method",
            "problemMatcher": [],
            "presentation": {
                "group": "quality-group"
            }
        },
        {
            "label": "Pylint Test",
            "type": "shell",
            "command": "pylint tests/ --disable=duplicate-code",
            "problemMatcher": [],
            "presentation": {
                "group": "quality-group"
            }
        },
        {
            "label": "Ruff Check",
            "type": "shell",
            "command": "ruff check",
            "problemMatcher": [],
            "presentation": {
                "group": "quality-group"
            }
        },
        {
            "label": "Code Quality Checks",
            "dependsOn": [
                "Pylint Component",
                "Pylint Test",
                "Ruff Check"
            ],
            "problemMatcher": []
        }
    ]
}