{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Run Home Assistant on port 8123",
            "type": "shell",
            "command": "scripts/develop",
            "problemMatcher": []
        },
        {
            "label": "Pytest + Logging + Failon_1st + Test Matching + Snapshot Update",
            "type": "shell",
            "command": "pytest --log-cli-level=INFO -x -k 'test_climate_platform' --snapshot-update",
            "problemMatcher": []
        },
        {
            "label": "MQTT Broker CERT",
            "type": "shell",
            "presentation": {
                "echo": false
            },
            "command": [
                "openssl req -x509 -out tests/broker.crt -keyout tests/broker.key ",
                "-newkey rsa:2048 -nodes -sha256 ",
                "-subj '/CN=localhost' -extensions EXT -config <( ",
                " printf '[dn]\nCN=localhost\n[req]\ndistinguished_name = dn\n[EXT]\nsubjectAltName=DNS:localhost\nkeyUsage=digitalSignature\nextendedKeyUsage=serverAuth')"
            ],
            "problemMatcher": []
        },
        {
            "label": "Run MQTT Broker",
            "type": "shell",
            "dependsOn": [
                "MQTT Broker CERT"
            ],
            "presentation": {
                "echo": false
            },
            "command": [
                "if ! pgrep -x \"mosquitto\" > /dev/null; then\n",
                "   echo \"Mosquitto is not running. Starting...\"\n",
                "   mosquitto -c tests/broker.cfg\n",
                "else\n",
                "   echo \"Mosquitto is already running.\"\n",
                "fi"
            ],
            "problemMatcher": []
        },
        {
            "label": "Run MQTT Broker in Background",
            "type": "shell",
            "dependsOn": [
                "MQTT Broker CERT"
            ],
            "presentation": {
                "echo": false
            },
            "command": [
                "if ! pgrep -x \"mosquitto\" > /dev/null; then\n",
                "   echo \"Mosquitto is not running. Starting...\"\n",
                "   mosquitto -c tests/broker.cfg &\n",
                "   sleep 5\n",
                "else\n",
                "   echo \"Mosquitto is already running.\"\n",
                "fi"
            ],
            "problemMatcher": []
        },
        {
            "label": "Stop MQTT Broker",
            "type": "shell",
            "command": "pkill mosquitto",
            "problemMatcher": []
        },
        {
            "label": "Pytest & Coverage Badge & Coverage Report",
            "type": "shell",
            "dependsOn": [
                "Run MQTT Broker in Background"
            ],
            "command": [
                "pytest -vv --cov=custom_components/traeger && ",
                "coverage-badge -o images/coverage.svg -f && ",
                "coverage html -d tests/coverage"
            ],
            "problemMatcher": []
        },
        {
            "label": "Pylint Component",
            "type": "shell",
            "command": [
                "pylint custom_components/traeger/ ",
                "--disable=duplicate-code,abstract-method,overridden-final-method"
            ],
            "problemMatcher": [],
            "presentation": {
                "group": "quality-group"
            }
        },
        {
            "label": "Pylint Test",
            "type": "shell",
            "command": "pylint tests/ --disable=duplicate-code",
            "problemMatcher": [],
            "presentation": {
                "group": "quality-group"
            }
        },
        {
            "label": "Ruff Check",
            "type": "shell",
            "command": "ruff check",
            "problemMatcher": [],
            "presentation": {
                "group": "quality-group"
            }
        },
        {
            "label": "Code Quality Checks",
            "dependsOn": [
                "Pylint Component",
                "Pylint Test",
                "Ruff Check"
            ],
            "problemMatcher": []
        }
    ]
}